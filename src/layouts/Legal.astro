---
// Páginas legales. Mientras sean borrador: aviso visible arriba y noindex.
import Base from './Base.astro'
import Cabecera from '../sections/Cabecera.astro'
import Pie from '../sections/Pie.astro'
import Icon from '../components/Icon.astro'

interface Props {
  titulo: string
  descripcion: string
  actualizado: string
}
const { titulo, descripcion, actualizado } = Astro.props
const OTRAS = [
  { href: '/terminos', label: 'Términos y condiciones' },
  { href: '/privacidad', label: 'Privacidad' },
  { href: '/aviso-legal', label: 'Aviso legal' },
  { href: '/cookies', label: 'Cookies' },
]
const actual = Astro.url.pathname.replace(/\/$/, '')
---

<Base title={`${titulo} · Captapisos`} description={descripcion} noindex>
  <Cabecera />
  <main id="contenido">
    <div class="marco pt-12 pb-20 sm:pt-16">
      <div class="mx-auto max-w-3xl">
        <div role="note" class="flex items-start gap-3 rounded-tarjeta border border-ascua/40 bg-fondo-alt px-4 py-3 text-pequeno">
          <Icon name="alerta" class="mt-0.5 size-4 shrink-0 text-ascua" />
          <p>
            <strong class="font-semibold">Borrador pendiente de revisión legal.</strong>{' '}
            Este texto es provisional y puede cambiar. Los datos entre corchetes se completarán antes de publicarlo.
          </p>
        </div>

        <span class="antetitulo mt-10">Legal</span>
        <h1 class="titulo-1 mt-5">{titulo}</h1>
        <p class="mt-3 text-pequeno text-tinta-suave">Última actualización: {actualizado}</p>

        <nav aria-label="Textos legales" class="mt-6 flex flex-wrap gap-2">
          {
            OTRAS.map((o) => (
              <a
                href={o.href}
                aria-current={o.href === actual ? 'page' : undefined}
                class:list={[
                  'rounded-full border px-3 py-1.5 text-[13px]',
                  o.href === actual ? 'border-tinta bg-tinta text-fondo' : 'border-linea text-tinta-suave hover:border-tinta hover:text-tinta',
                ]}
              >
                {o.label}
              </a>
            ))
          }
        </nav>

        <article class="legal mt-10">
          <slot />
        </article>
      </div>
    </div>
  </main>
  <Pie />
</Base>

<style>
  .legal :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.25rem;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .legal :global(h3) {
    margin-top: 1.5rem;
    font-weight: 600;
  }
  .legal :global(p),
  .legal :global(ul),
  .legal :global(ol),
  .legal :global(dl) {
    margin-top: 0.75rem;
    color: var(--color-tinta-suave);
  }
  .legal :global(ul) { list-style: disc; padding-left: 1.25rem; }
  .legal :global(ol) { list-style: decimal; padding-left: 1.25rem; }
  .legal :global(li) { margin-top: 0.375rem; }
  .legal :global(strong) { color: var(--color-tinta); font-weight: 600; }
  .legal :global(a) {
    color: var(--color-tinta);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .legal :global(a:hover) { color: var(--color-senal-texto); }
  .legal :global(table) {
    margin-top: 1rem;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .legal :global(th),
  .legal :global(td) {
    border-top: 1px solid var(--color-linea);
    padding: 0.625rem 0.75rem 0.625rem 0;
    text-align: left;
    vertical-align: top;
  }
  .legal :global(th) { color: var(--color-tinta); font-weight: 600; }
  .legal :global(td) { color: var(--color-tinta-suave); }
</style>

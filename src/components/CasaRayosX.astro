---
// La vivienda en estructura de alambre naranja, como una radiografía, con el punto de señal.
interface Props {
  class?: string
  suelo?: boolean
  latido?: boolean
}
const { class: className = '', suelo = true, latido = false } = Astro.props
---

<svg viewBox="0 0 420 340" class={className} fill="none" aria-hidden="true">
  {
    suelo && (
      <g class="stroke-linea" stroke-width="1.25">
        <path d="M18 286 196 330l206-58" />
        <path d="M52 272 196 306l172-48" />
      </g>
    )
  }
  <g class="stroke-senal" stroke-width="2" stroke-linejoin="round">
    <path d="M70 150 150 78l80 72v130H70z"></path>
    <path d="M150 78 258 30l92 64-120 56"></path>
    <path d="M230 150 350 94v128l-120 58"></path>
  </g>
  <g class="stroke-senal" stroke-width="1.25" opacity="0.85">
    <path d="M150 78v202M70 215h160"></path>
    <path d="M290 122v130M230 215l120-56"></path>
    <path d="M204 54l92 64"></path>
    <rect x="92" y="166" width="36" height="34"></rect>
    <rect x="172" y="166" width="36" height="34"></rect>
    <rect x="92" y="232" width="30" height="34"></rect>
    <rect x="178" y="232" width="30" height="34"></rect>
    <path d="M252 168v28l22-10v-28zM306 142v28l22-10v-28z"></path>
  </g>
  <g class="stroke-senal">
    <circle cx="150" cy="182" r="46" stroke-width="1" opacity="0.3" class:list={[latido && 'onda onda-1']}></circle>
    <circle cx="150" cy="182" r="24" stroke-width="1.25" opacity="0.55" class:list={[latido && 'onda onda-2']}></circle>
  </g>
  <circle cx="150" cy="182" r="9" class="fill-senal"></circle>
</svg>

<style>
  /* Sin movimiento si el usuario lo prefiere: las ondas se quedan quietas. */
  @media (prefers-reduced-motion: no-preference) {
    .onda {
      transform-box: fill-box;
      transform-origin: center;
      animation: onda 3.2s ease-out infinite;
    }
    .onda-2 { animation-delay: 0.4s; }
  }
  @keyframes onda {
    0% { transform: scale(0.6); opacity: 0.7; }
    80%, 100% { transform: scale(1.25); opacity: 0; }
  }
</style>

---
import Icon from '../components/Icon.astro'

// Aviso de ejemplo: datos inventados para ilustrar, no es un anuncio real.
const PUNTUACION = 88
const MOTIVOS = [
  { w: 45, label: 'El portal marca al anunciante como «Particular»' },
  { w: 10, label: 'Solo tiene este anuncio publicado' },
  { w: 8, label: 'El nombre del anunciante parece de una persona' },
  { w: -20, label: 'Redacción con estilo comercial («magnífico», «ideal para…»)' },
  { w: -5, label: 'Revisión con IA: no tiene claro quién lo ha escrito' },
]
const signo = (w: number) => (w > 0 ? `+${w}` : `−${Math.abs(w)}`)
/** Barra divergente: a la derecha suma (Señal), a la izquierda resta (tinta suave). Escala ±70. */
const ancho = (w: number) => (Math.min(Math.abs(w), 70) / 70) * 50

const r = 19
const c = 2 * Math.PI * r

const PARTES = [
  {
    titulo: 'Ubicación exacta',
    texto: 'Barrio, distrito y municipio de cada anuncio de particular, para saber al momento si es tu zona.',
  },
  {
    titulo: 'Puntuación de 0 a 100, con motivos',
    texto:
      'Todos los anuncios parten de 50 y cada señal suma o resta. Ves cada una: lo que dice el portal, el anunciante, el texto y, si está activada, la revisión con IA.',
  },
  {
    titulo: 'Etiquetas útiles para captar',
    texto: '«Abstenerse agencias», «Herencia», «Urgente», «Para reformar»… detectadas en el propio anuncio.',
  },
  {
    titulo: 'Estado de cada aviso',
    texto: 'Sin ver, contactado o descartado. Tu lista de captación al día, en el mismo sitio donde te llegan.',
  },
]
---

<section id="el-aviso" class="seccion bg-fondo-alt" aria-labelledby="aviso-titulo">
  <div class="marco grid gap-12 py-20 sm:py-24 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
    <div>
      <span class="antetitulo">03 · El aviso</span>
      <h2 id="aviso-titulo" class="titulo-1 mt-5">Cada aviso explica <span class="text-senal">por qué.</span></h2>
      <p class="entradilla mt-5">
        Ningún portal te dice de forma fiable quién es particular y quién es agencia. Por eso no te damos un sí o un
        no: te damos una puntuación y sus motivos, para que llames con criterio.
      </p>
      <ol class="mt-10 space-y-6">
        {
          PARTES.map((p, i) => (
            <li class="grid grid-cols-[2rem_1fr] gap-3">
              <span class="etiqueta pt-1 text-senal-texto">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-semibold tracking-[-0.01em]">{p.titulo}</h3>
                <p class="mt-1 text-pequeno text-tinta-suave">{p.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="min-w-0">
      <div class="bloque papel-milimetrado bg-fondo-alt p-3 sm:p-6">
        <article class="aviso-ejemplo tarjeta relative overflow-hidden shadow-flotante" aria-labelledby="ejemplo-titulo">
          <span class="barra-nuevo absolute inset-y-0 left-0 w-[3px] bg-senal" aria-hidden="true"></span>
          <div class="flex flex-col gap-4 p-4 sm:p-6">
            <div class="flex items-start gap-4">
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="chip chip-nuevo estado-nuevo">Nuevo · Particular</span>
                  <span class="chip chip-borde estado-visto">Particular</span>
                  <span class="chip chip-ejemplo">Ejemplo</span>
                  <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-tinta-suave">
                    <span class="punto-senal estado-nuevo size-1.5"></span>hace 2 min
                  </span>
                </div>
                <h3 id="ejemplo-titulo" class="titulo-3 mt-3">Piso de 3 hab. con terraza</h3>
                <p class="mt-1 flex items-center gap-1.5 text-pequeno">
                  <Icon name="pin" class="size-3.5 shrink-0 text-tinta-suave" />
                  Trafalgar · Chamberí · Madrid
                </p>
                <p class="mt-1 flex flex-wrap items-center gap-x-1.5 text-pequeno text-tinta-suave">
                  <Icon name="campana" class="size-3.5" />
                  <span>Alerta «Chamberí, 3 hab.»</span>
                  <span aria-hidden="true">·</span>
                  <span>idealista</span>
                </p>
                <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Etiquetas del anuncio">
                  <li class="chip chip-neutro">Herencia</li>
                  <li class="chip chip-neutro">Para reformar</li>
                </ul>
              </div>
              <div class="relative size-[52px] shrink-0" title={`Puntuación de propietario: ${PUNTUACION}/100`}>
                <svg viewBox="0 0 44 44" class="size-full -rotate-90" aria-hidden="true">
                  <circle cx="22" cy="22" r={r} class="fill-none stroke-linea" stroke-width="3"></circle>
                  <circle
                    cx="22"
                    cy="22"
                    r={r}
                    class="fill-none stroke-senal"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-dasharray={c}
                    stroke-dashoffset={c * (1 - PUNTUACION / 100)}
                  ></circle>
                </svg>
                <span class="cifra absolute inset-0 grid place-items-center text-[15px]" aria-hidden="true">{PUNTUACION}</span>
                <span class="sr-only">Puntuación de propietario: {PUNTUACION} de 100</span>
              </div>
            </div>

            <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4 border-t border-linea pt-4">
              <p class="cifra text-[28px] leading-none">412.000 €</p>
              <dl class="flex flex-wrap gap-x-6 gap-y-2">
                {
                  [
                    ['Hab.', '3'],
                    ['Sup.', '94 m²'],
                    ['€/m²', '4.383'],
                    ['Planta', '4.ª'],
                  ].map(([k, v]) => (
                    <div>
                      <dt class="etiqueta text-[11px] text-tinta-suave">{k}</dt>
                      <dd class="mt-1 text-pequeno font-medium tabular-nums">{v}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>

            <p class="text-pequeno text-tinta-suave">
              Magnífico piso exterior en Trafalgar, ideal para reformar a tu gusto. Vivienda heredada, tres dormitorios,
              terraza y ascensor…
            </p>

            <div class="flex flex-wrap items-center gap-x-3 text-pequeno">
              <span class="etiqueta text-[11px] text-tinta-suave">Anunciante</span>
              <span class="font-medium">Marta</span>
            </div>

            <details class="group rounded-tarjeta bg-fondo-alt" open>
              <summary class="flex cursor-pointer items-center justify-between gap-3 rounded-tarjeta px-4 py-3">
                <span class="etiqueta text-[11px] text-tinta-suave">¿Por qué {PUNTUACION}? Cómo sale la puntuación</span>
                <Icon name="chevron" class="size-4 text-tinta-suave transition-transform group-open:rotate-180" />
              </summary>
              <div class="px-4 pb-4">
                <ul class="divide-y divide-linea text-pequeno">
                  <li class="flex items-center gap-3 py-2">
                    <span class="w-9 shrink-0 text-right font-mono text-[13px] tabular-nums text-tinta-suave">50</span>
                    <span class="relative hidden h-1.5 w-20 shrink-0 rounded-full bg-linea/70 sm:block" aria-hidden="true">
                      <span class="absolute inset-y-[-3px] left-1/2 w-px bg-linea-fuerte/60"></span>
                    </span>
                    <span class="text-tinta-suave">Todos los anuncios parten de 50</span>
                  </li>
                  {
                    MOTIVOS.map((m) => (
                      <li class="flex items-center gap-3 py-2">
                        <span
                          class:list={[
                            'w-9 shrink-0 text-right font-mono text-[13px] font-medium tabular-nums',
                            m.w > 0 ? 'text-senal-texto' : 'text-tinta',
                          ]}
                        >
                          <span class="sr-only">{m.w > 0 ? 'Suma' : 'Resta'} </span>
                          {signo(m.w)}
                        </span>
                        <span class="relative hidden h-1.5 w-20 shrink-0 rounded-full bg-linea/70 sm:block" aria-hidden="true">
                          <span class="absolute inset-y-[-3px] left-1/2 w-px bg-linea-fuerte/60" />
                          <span
                            class:list={['absolute inset-y-0 rounded-full', m.w > 0 ? 'bg-senal' : 'bg-tinta-suave']}
                            style={m.w > 0 ? `left:50%;width:${ancho(m.w)}%` : `right:50%;width:${ancho(m.w)}%`}
                          />
                        </span>
                        <span class="min-w-0">{m.label}</span>
                      </li>
                    ))
                  }
                </ul>
                <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-tinta pt-3">
                  <span class="w-9 shrink-0 text-right font-mono text-[13px] font-medium tabular-nums">{PUNTUACION}</span>
                  <span class="text-pequeno font-medium">Resultado, entre 0 y 100</span>
                  <span class="chip chip-borde ml-auto">Particular</span>
                </div>
              </div>
            </details>

            <fieldset class="estado flex flex-wrap items-center gap-2 border-t border-linea pt-4">
              <legend class="etiqueta float-left mr-2 text-[11px] text-tinta-suave">Estado</legend>
              {
                [
                  ['sin-ver', 'Sin ver', true],
                  ['contactado', 'Contactado', false],
                  ['descartado', 'Descartado', false],
                ].map(([v, label, checked]) => (
                  <label class="opcion btn btn-xs btn-secundario">
                    <input type="radio" name="estado-ejemplo" value={v as string} checked={checked as boolean} class="sr-only" />
                    <Icon name="check" class="marca hidden" />
                    {label}
                  </label>
                ))
              }
            </fieldset>
          </div>
        </article>
        <p class="etiqueta mt-4 px-1 text-[11px] text-tinta-suave">
          Ejemplo ilustrativo · Datos inventados, no es un anuncio real
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* El estado se cambia con radios (sin JS): lo nuevo es naranja; lo descartado se apaga. */
  .estado-visto { display: none; }
  .aviso-ejemplo:not(:has(input[value='sin-ver']:checked)) .barra-nuevo,
  .aviso-ejemplo:not(:has(input[value='sin-ver']:checked)) .estado-nuevo { display: none; }
  .aviso-ejemplo:not(:has(input[value='sin-ver']:checked)) .estado-visto { display: inline-flex; }
  .aviso-ejemplo:has(input[value='descartado']:checked) > :not(.barra-nuevo) > :not(.estado) { opacity: 0.55; }
  .opcion:has(input:checked) {
    border-color: var(--color-tinta);
    background: var(--color-fondo-alt);
  }
  .opcion:has(input:checked) :global(.marca) { display: block; }
  .opcion:has(input:focus-visible) {
    outline: 2px solid var(--color-senal);
    outline-offset: 2px;
  }
</style>

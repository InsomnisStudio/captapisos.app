---
import Base from '../layouts/Base.astro'
import Cabecera from '../sections/Cabecera.astro'
import Hero from '../sections/Hero.astro'
import Problema from '../sections/Problema.astro'
import ComoFunciona from '../sections/ComoFunciona.astro'
import ElAviso from '../sections/ElAviso.astro'
import Alertas from '../sections/Alertas.astro'
import TiempoReal from '../sections/TiempoReal.astro'
import Precios from '../sections/Precios.astro'
import Preguntas from '../sections/Preguntas.astro'
import Portales from '../sections/Portales.astro'
import CtaFinal from '../sections/CtaFinal.astro'
import Pie from '../sections/Pie.astro'
import { schemaPortada } from '../lib/seo'
---

<Base schema={schemaPortada(Astro.site!)}>
  <Cabecera />
  <main id="contenido">
    <Hero />
    <Problema />
    <ComoFunciona />
    <ElAviso />
    <Alertas />
    <TiempoReal />
    <Precios />
    <Preguntas />
    <Portales />
    <CtaFinal />
  </main>
  <Pie />
</Base>

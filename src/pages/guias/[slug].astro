---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import Cabecera from '../../sections/Cabecera.astro'
import Pie from '../../sections/Pie.astro'
import Icon from '../../components/Icon.astro'
import { URL_REGISTRO } from '../../lib/config'
import { fechaIso, fechaLarga } from '../../lib/fechas'
import { schemaGuia } from '../../lib/seo'

export async function getStaticPaths() {
  const guias = await getCollection('guias')
  return guias.map((guia) => ({ params: { slug: guia.id }, props: { guia } }))
}

const { guia } = Astro.props
const { Content } = await render(guia)
const { titulo, tituloSeo, descripcion, publicado, actualizado } = guia.data
const fecha = actualizado ?? publicado
---

<Base
  title={tituloSeo ?? `${titulo} · Captapisos`}
  description={descripcion}
  schema={schemaGuia(Astro.site!, { slug: guia.id, titulo, descripcion, publicado, actualizado })}
>
  <Cabecera />
  <main id="contenido">
    <div class="marco pt-12 pb-20 sm:pt-16">
      <div class="mx-auto max-w-3xl">
        <nav aria-label="Ruta" class="text-pequeno text-tinta-suave">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/" class="hover:text-tinta">Inicio</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/guias" class="hover:text-tinta">Guías</a></li>
          </ol>
        </nav>

        <span class="antetitulo mt-10">Guía</span>
        <h1 class="titulo-1 mt-5">{titulo}</h1>
        <p class="entradilla mt-5">{descripcion}</p>
        <p class="mt-4 text-pequeno text-tinta-suave">
          {actualizado ? 'Actualizada el ' : 'Publicada el '}
          <time datetime={fechaIso(fecha)}>{fechaLarga(fecha)}</time>
        </p>

        <article class="prosa mt-10">
          <Content />
        </article>

        <aside class="bloque papel-milimetrado mt-16 px-6 py-10 text-center sm:px-10" aria-labelledby="guia-cta">
          <h2 id="guia-cta" class="titulo-3">Que los particulares de tu zona te lleguen solos</h2>
          <p class="mx-auto mt-3 max-w-lg text-tinta-suave">
            Captapisos vigila los anuncios nuevos, puntúa si son de particular con sus motivos y te avisa a los pocos
            minutos. 7 días gratis.
          </p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <a href={URL_REGISTRO} class="btn btn-primario">
              Empieza tu prueba gratis
              <Icon name="flecha" />
            </a>
            <a href="/#como-funciona" class="btn btn-secundario">Ver cómo funciona</a>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <Pie />
</Base>

# URL del portal (la app). Los CTA llevan a ${PUBLIC_APP_URL}/registro y ${PUBLIC_APP_URL}/login.
PUBLIC_APP_URL=http://localhost:5173
# URL del backend. El hero pide ${PUBLIC_API_URL}/api/public/sample-listing para mostrar un anuncio real
# anonimizado; si no responde, se queda la tarjeta de ejemplo.
PUBLIC_API_URL=http://localhost:8080
# URL pública de esta landing (canonical y Open Graph).
PUBLIC_SITE_URL=https://captapisos.app
